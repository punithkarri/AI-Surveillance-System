# Deployment and alert configuration
DEPLOYMENT_MODE=true
ALARM_COOLDOWN_SECONDS=1.5
CONFIDENCE_THRESHOLD=0.5
THREAT_THRESHOLD=70
RECORDING_FPS=20
FRAME_WIDTH=640
FRAME_HEIGHT=480
MAX_SCREENSHOTS=10

# Email settings (optional)
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=alerts@example.com
EMAIL_PASSWORD=supersecretpassword
ALERT_RECIPIENT=security-team@example.com
